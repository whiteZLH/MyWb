# 一键部署的配置文件。默认由 deploy.sh 自动生成到数据目录 $MYWB_HOME/.env
# （默认 /opt/mywb/.env），并与代码仓库分离。
# 也可手动创建：复制本文件到 $MYWB_HOME/.env 后填写。
# 生成随机值示例：python3 -c "import secrets; print(secrets.token_urlsafe(36))"
#
# 本文件会被挂载进容器（/app/.env，只读），容器启动时自动加载，
# 因此下列开关（PORT、ADMIN_SECURE_COOKIE 以及 core 层的 CODEBUDDY_* 选项）均生效。
# 完整选项与取值规则见仓库根目录 .env.example。
ADMIN_KEY=
CODEBUDDY2OPENAI_KEY=
PORT=8787

# 会话 Cookie 是否加 Secure 标志，默认 0（关闭），便于纯 HTTP / 局域网访问；
# 通过 HTTPS 反向代理对外时设为 1。
# ADMIN_SECURE_COOKIE=0
