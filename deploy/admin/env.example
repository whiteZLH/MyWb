# Generate two different random values before starting the console.
# Example generation command: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
ADMIN_KEY=
CODEBUDDY2OPENAI_KEY=

# 以下均有默认值，按需取消注释覆盖。
# 取值规则：显式参数 > 进程环境变量 > .env > 默认值（当前运行目录）。
# 相对路径一律相对当前运行目录解析。
#
# 账号索引与密钥摘要目录（state.json / metrics.json），默认：当前运行目录
# ADMIN_DIR=.
#
# 登录凭据目录，默认：<当前运行目录>/auth
# CODEBUDDY_AUTH_DIR=./auth
#
# 监听端口，默认：8787
# PORT=8787
