# 本项目统一配置示例：复制为 .env 后填写。
# 取值规则（从高到低）：显式参数 > 进程环境变量 > .env 文件 > 默认值（当前运行目录）。
# `python -m admin.server` 会自动加载当前运行目录下的 .env，因此无需先 export。
# 相对路径相对当前运行目录解析。
#
# 生成随机值示例：python3 -c "import secrets; print(secrets.token_urlsafe(36))"

# ---------- 管理后台（python -m admin.server） ----------
# 管理密钥，至少 20 字符，必填。务必改成自己随机生成的值，不要照抄示例。
ADMIN_KEY=

# 首次迁入的客户端 API Key；初始化后从持久化状态读取密钥列表。
CODEBUDDY2OPENAI_KEY=

# ---------- 目录与端口（默认值 = 当前运行目录） ----------
# 数据目录：SQLite 数据库 mywb.db 与凭据元数据，默认：当前运行目录
# 兼容旧变量 MANAGEMENT_DATA_DIR，两者都设置时 ADMIN_DIR 优先。
# ADMIN_DIR=.

# 登录凭据目录，默认：<当前运行目录>/auth
# 注意：一旦显式设置，不再自动发现桌面端登录态。
# CODEBUDDY_AUTH_DIR=./auth

# 监听端口，默认：8787
# PORT=8787

# 后台会话 Cookie 是否加 Secure 标志，默认 0（关闭），便于纯 HTTP / 局域网访问。
# 若通过 HTTPS 反向代理对外提供服务，建议设为 1，避免 Cookie 在明文链路泄露。
# ADMIN_SECURE_COOKIE=0

# ---------- 可选开关 ----------
# 请求记录与统计在管理后台「请求记录 / 运行统计」页查看，不再写文件日志。

# 是否向前端透出模型思考过程，默认 1（开启），设 0 关闭。
# CODEBUDDY_REASONING=1

# 思考内容换行规整，默认 1（开启），设 0 关闭。
# CODEBUDDY_REASONING_JOIN=1

# 剥离上游空 tool_calls 数组，默认 1（开启），设 0 关闭。
# CODEBUDDY_STRIP_EMPTY_TOOLCALLS=1

# Responses 链路脱敏相关（默认关闭）。
# CODEBUDDY_RESPONSES_DESENSITIZE=1
# CODEBUDDY_LOSSY_PROJECTION=1

# ---------- 上游出口匀速（防 IP 速率型 WAF/429） ----------
# 全部上游请求共享的总速率上限（req/s）。目标平台按出口 IP 做速率风控，
# 同一 IP 聚合约每秒 3 个请求即触发 WAF。默认 2（留余量），0 表示关闭。
# 管理后台「账号池」页内的设置会覆盖此处的兜底值；此处仅用于独立转换器模式。
# CODEBUDDY_EGRESS_RPS=2
# 空闲后允许的突发槽位数，默认 1（严格匀速）。
# CODEBUDDY_EGRESS_BURST=1
# 单个请求排队等待上限（秒），超过则返回 429。默认 10。
# CODEBUDDY_EGRESS_MAX_WAIT=10

# ---------- 出口代理（可选） ----------
# 全局出口代理；Docker 直接 `-e CODEBUDDY_EGRESS_PROXY=http://host:port` 即可。
# 留空 = 直连（httpx 仍会读取 HTTP(S)_PROXY / ALL_PROXY）。
# 支持 http(s):// 与 socks5(h)://；socks5 需 `pip install httpx[socks]`。
# 账号级代理（面板账号「代理」）会覆盖此全局值。
# CODEBUDDY_EGRESS_PROXY=http://127.0.0.1:7897

# ---------- 内置 VLESS（每个账号不同节点 → 不同出站 IP） ----------
# 全局默认节点：一条 vless:// 分享链接（多行取第一条）。留空 = 不用。
# 镜像已内置静态 sing-box；账号「代理」栏填 vless://... 即可让该账号走该节点。
# CODEBUDDY_EGRESS_VLESS=vless://uuid@host:443?type=ws&security=tls&host=...&path=/...&sni=...&fp=ios
# 内核路径（默认自动在 PATH / /usr/local/bin / /usr/bin 找 sing-box）。
# CODEBUDDY_VLESS_BIN=/usr/local/bin/sing-box

# ---------- 加载器自身 ----------
# 指定其它位置的 .env 文件，便于多实例隔离。
# MYWB_ENV_FILE=D:\instances\a\.env
# 关闭 .env 自动加载（仅测试用）。
# MYWB_SKIP_DOTENV=1
