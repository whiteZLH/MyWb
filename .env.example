# 本项目统一配置示例：复制为 .env 后填写。
# 取值规则（从高到低）：显式参数 > 进程环境变量 > .env 文件 > 默认值（当前运行目录）。
# `python -m admin.server` 与 `python -m core.converter` 都会自动加载当前运行目录
# 下的 .env，因此无需先 export。相对路径相对当前运行目录解析。
#
# 生成随机值示例：python3 -c "import secrets; print(secrets.token_urlsafe(36))"

# ---------- 管理后台（python -m admin.server） ----------
# 管理密钥，至少 20 字符，必填。
ADMIN_KEY=1234512345123451234512345

# 首次迁入的客户端 API Key；初始化后从持久化状态读取密钥列表。
CODEBUDDY2OPENAI_KEY=1234512345123451234512345

# ---------- 目录与端口（默认值 = 当前运行目录） ----------
# 账号索引与密钥摘要目录（state.json / metrics.json），默认：当前运行目录
# 兼容旧变量 MANAGEMENT_DATA_DIR，两者都设置时 ADMIN_DIR 优先。
# ADMIN_DIR=.

# 登录凭据目录，默认：<当前运行目录>/auth
# 注意：一旦显式设置，独立转换器不再自动发现桌面端登录态。
# CODEBUDDY_AUTH_DIR=./auth

# 监听端口，默认：8787
# PORT=8787

# ---------- 可选开关 ----------
# 日志路径，不设置则不记日志。
# CODEBUDDY2OPENAI_LOG=converter.log

# 是否向前端透出模型思考过程，默认 1（开启），设 0 关闭。
# CODEBUDDY_REASONING=1

# 思考内容换行规整，默认 1（开启），设 0 关闭。
# CODEBUDDY_REASONING_JOIN=1

# 剥离上游空 tool_calls 数组，默认 1（开启），设 0 关闭。
# CODEBUDDY_STRIP_EMPTY_TOOLCALLS=1

# Responses 链路脱敏相关（默认关闭）。
# CODEBUDDY_RESPONSES_DESENSITIZE=1
# CODEBUDDY_LOSSY_PROJECTION=1

# ---------- 加载器自身 ----------
# 指定其它位置的 .env 文件，便于多实例隔离。
# MYWB_ENV_FILE=D:\instances\a\.env
# 关闭 .env 自动加载（仅测试用）。
# MYWB_SKIP_DOTENV=1
